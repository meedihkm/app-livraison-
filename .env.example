# ============================================
# CONFIGURATION - AWID LIVRAISON
# ============================================
# Copier ce fichier en .env et remplir les valeurs

# ============================================
# 🔐 SECRETS (À GÉNÉRER)
# ============================================

# Mot de passe PostgreSQL
DB_PASSWORD=your_db_password_here

# JWT Secret (64 caractères minimum)
JWT_SECRET=your_jwt_secret_here

# Super Admin Key (32 caractères minimum)
SUPER_ADMIN_KEY=your_super_admin_key_here

# ============================================
# 🗄️ BASE DE DONNÉES
# ============================================

# PostgreSQL
DATABASE_URL=postgresql://awid_user:${DB_PASSWORD}@localhost:5432/awid

# SSL
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Pool de connexions
DATABASE_POOL_MAX=20

# ============================================
# 🔴 REDIS
# ============================================

# Redis
REDIS_URL=redis://localhost:6379

# ============================================
# 🌐 SERVEUR & CORS
# ============================================

# Environnement
NODE_ENV=production

# Port de l'API
PORT=3000

# CORS - Remplacer par vos domaines
CORS_ORIGINS=http://localhost:3000,https://votre-domaine.com

# ============================================
# 👤 SUPER ADMIN
# ============================================

# Nom affiché dans l'app 2FA
SUPER_ADMIN_2FA_ISSUER=AWID Admin

# ============================================
# 📊 MONITORING (optionnel)
# ============================================

# Sentry DSN (laisser vide si non utilisé)
SENTRY_DSN=

# ============================================
# 🔧 COMMANDES POUR GÉNÉRER LES SECRETS
# ============================================
#
# DB_PASSWORD:
#   openssl rand -base64 32
#
# JWT_SECRET:
#   openssl rand -hex 64
#
# SUPER_ADMIN_KEY:
#   openssl rand -hex 32
#
