# ==========================================
# AWID v3.0 - Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# ==========================================

# ==========================================
# BASE DE DONNÉES - PostgreSQL
# ==========================================
POSTGRES_USER=awid_admin
POSTGRES_PASSWORD=change_me_strong_password_123
POSTGRES_DB=awid_v3

# ==========================================
# PGADMIN
# ==========================================
PGADMIN_EMAIL=admin@awid.dz
PGADMIN_PASSWORD=change_me_pgadmin_456

# ==========================================
# REDIS
# Pas besoin de variables supplémentaires
# ==========================================

# ==========================================
# JWT - Génère des clés fortes !
# ==========================================
JWT_SECRET=votre_jwt_secret_tres_long_et_aleatoire_64_chars_minimum
JWT_REFRESH_SECRET=votre_refresh_secret_tres_long_et_different_du_jwt

# ==========================================
# MINIO (S3)
# ==========================================
MINIO_ROOT_USER=awidminio
MINIO_ROOT_PASSWORD=change_me_minio_789_very_secure
MINIO_BUCKET=awid-uploads

# ==========================================
# BACKEND
# ==========================================
NODE_ENV=production
PORT=3000

# Ces variables sont auto-générées, ne pas modifier
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
# REDIS_URL=redis://redis:6379
# S3_ENDPOINT=http://minio:9000

# Optionnel : Configuration email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@awid.dz

# Optionnel : Configuration SMS (Twilio ou autre)
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=

# ==========================================
# DOMAINS (Auto-générés par Coolify)
# Ces variables seront remplies par Coolify
# ==========================================
# BACKEND_DOMAIN=xxx.coolify.io
# ADMIN_DOMAIN=xxx.coolify.io  
# PGADMIN_DOMAIN=db-xxx.coolify.io
# MINIO_DOMAIN=s3-xxx.coolify.io
# MINIO_CONSOLE_DOMAIN=console-s3-xxx.coolify.io
