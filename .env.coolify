# ============================================
# CONFIGURATION COOLIFY - AWID LIVRAISON
# ============================================
# Ce fichier unifie TOUTE la configuration
# Copier dans Coolify > Variables d'environnement

# ============================================
# 🔐 SECRETS (À GÉNÉRER - voir commandes en bas)
# ============================================

# Mot de passe PostgreSQL
DB_PASSWORD=CHANGEME_DB_PASSWORD

# JWT Secret (64 caractères minimum)
JWT_SECRET=CHANGEME_JWT_SECRET

# Super Admin Key (32 caractères minimum)
SUPER_ADMIN_KEY=CHANGEME_SUPER_ADMIN_KEY

# ============================================
# 🗄️ BASE DE DONNÉES
# ============================================

# PostgreSQL - Connexion interne Docker
DATABASE_URL=postgresql://awid_user:${DB_PASSWORD}@awid-postgres:5432/awid

# SSL (désactivé pour connexion interne Docker)
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Pool de connexions
DATABASE_POOL_MAX=20

# ============================================
# 🔴 REDIS
# ============================================

# Redis - Connexion interne Docker
REDIS_URL=redis://awid-redis:6379

# ============================================
# 🌐 SERVEUR & CORS
# ============================================

# Environnement
NODE_ENV=production

# Port de l'API
PORT=3000

# CORS - Remplacer par votre domaine
CORS_ORIGINS=http://62.171.130.92.sslip.io,http://api.62.171.130.92.sslip.io

# ============================================
# 👤 SUPER ADMIN
# ============================================

# Nom affiché dans l'app 2FA
SUPER_ADMIN_2FA_ISSUER=AWID Admin

# ============================================
# 📊 MONITORING (optionnel)
# ============================================

# Sentry DSN (laisser vide si non utilisé)
SENTRY_DSN=

# ============================================
# 🔧 COMMANDES POUR GÉNÉRER LES SECRETS
# ============================================
#
# Exécuter ces commandes sur votre machine :
#
# DB_PASSWORD:
#   openssl rand -base64 32
#
# JWT_SECRET:
#   openssl rand -hex 64
#
# SUPER_ADMIN_KEY:
#   openssl rand -hex 32
#
# ============================================
# 📝 INSTRUCTIONS COOLIFY
# ============================================
#
# 1. Générer les 3 secrets avec les commandes ci-dessus
# 2. Remplacer les valeurs CHANGEME dans ce fichier
# 3. Dans Coolify > Votre projet > Environment
# 4. Copier-coller TOUT ce fichier
# 5. Sauvegarder et redéployer
#
